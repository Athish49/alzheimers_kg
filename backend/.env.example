# =============================================================================
# Alzheimer's KG — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
#
# ENVIRONMENT DETECTION
# ---------------------
# Set to "local" or "cloud".
# If left blank, auto-detected from cloud platform env vars (Render, Railway,
# GCP, AWS, Heroku, Fly.io, Azure). Falls back to "local" if none found.
# =============================================================================

ENVIRONMENT=local

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# LLM_PROVIDER: ollama | openai | anthropic | groq | gemini
#   - local default  : ollama
#   - cloud default  : auto-selected from available API keys (groq → gemini fallback)
# LLM_MODEL: leave blank to use the provider default model
# LLM_API_KEY: API key for cloud providers (openai / anthropic / groq / gemini)
#   You can also set provider-specific keys below instead.
# =============================================================================

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Provider-specific API keys (preferred over LLM_API_KEY when set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Ollama base URL (local only)
OLLAMA_BASE_URL=http://localhost:11434/api

# =============================================================================
# NEO4J CONFIGURATION
# =============================================================================
# Local Neo4j (used when ENVIRONMENT=local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_local_password
NEO4J_DB=neo4j

# Cloud Neo4j — AuraDB or remote instance (used when ENVIRONMENT=cloud)
# Example AuraDB URI: neo4j+s://xxxxxxxx.databases.neo4j.io
CLOUD_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
CLOUD_NEO4J_USER=neo4j
CLOUD_NEO4J_PASSWORD=your_cloud_password
CLOUD_NEO4J_DB=neo4j

# =============================================================================
# URL CONFIGURATION
# =============================================================================
# Leave blank to use environment-appropriate defaults:
#   local  → http://localhost:5173 / http://localhost:8000
#   cloud  → must be set explicitly

FRONTEND_URL=https://your-frontend.onrender.com
BACKEND_URL=https://your-backend.onrender.com

# =============================================================================
# GRAPH RAG TUNING (optional overrides)
# =============================================================================
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=800
LLM_TIMEOUT_S=60

PROJECT_NAME=alzheimerskg
AD_DISEASE_ID=MONDO:0004975
GRAPH_RAG_MAX_HOPS=2
GRAPH_RAG_MAX_EDGES=300
GRAPH_RAG_TOPK_BIOMARKERS=50
GRAPH_RAG_TOPK_DRUGS=50
GRAPH_RAG_TOPK_PATHWAYS=50
GRAPH_RAG_TOPK_GENES=50
